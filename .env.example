# ==============================================================================
# AI Tech Consultant — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env files!

# ------------------------------------------------------------------------------
# 1. Database & Vector Store (PostgreSQL 18 + pgvector)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_tech_consultant
PGVECTOR_DIMENSION=1536

# ------------------------------------------------------------------------------
# 2. Cryptography & Vault Security (AES-256-GCM)
# ------------------------------------------------------------------------------
# Must be exactly 32 bytes (64 hex characters) for AES-256 encryption of API keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXTAUTH_SECRET=super_secret_session_signing_key_at_least_32_characters_long
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Model API Keys & Endpoints (The 14 Supported Models)
# ------------------------------------------------------------------------------
# Anthropic Claude API (Opus 5.5, Sonnet 5.5, Haiku 5.5)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini API (Gemini 3.8 Flash, Gemini 3 Flash, Gemini 2.5 Flash-Lite)
GEMINI_API_KEY=AIzaSy...

# OpenRouter API (Nemotron 3 Ultra, Super VL, Lightning, Gemma 4 31B, Qwen 3.8 Max, Qwen 3.7 Flash)
OPENROUTER_API_KEY=sk-or-v1-...

# Local Ollama Server (gemma4:e4b, qwen3.5:4b)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 (Gmail Read-Only Knowledge Ingestion)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ------------------------------------------------------------------------------
# 5. Application Flags & Operational Defaults
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOCAL_ONLY_MODE=false
CRAWL_MAX_CONCURRENCY=2
CRAWL_POLITE_DELAY_MS=250
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 6. Real Email & OTP Dispatch (SMTP / Gmail App Password)
# ------------------------------------------------------------------------------
# For real email delivery directly to your Gmail/Outlook/Yahoo inbox:
# 1. To use Gmail: generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
# 2. Fill in your Gmail address and generated App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Technologies & Consulting" <no-reply@aitechconsults.com>

